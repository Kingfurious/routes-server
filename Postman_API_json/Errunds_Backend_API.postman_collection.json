									"key": "taskId",
									"value": "YOUR_TASK_ID_HERE",
									"description": "The ID of the task"
								}
							]
						},
						"description": "End an active call. Updates call status to 'ended' with timestamp. Requires callId in request body. Only works for calls with status 'ringing' or 'connected'."
					},
					"response": []
				}
			],
			"description": "In-app calling endpoints using Agora RTC (Sprint 3). Requires AGORA_APP_ID and AGORA_APP_CERTIFICATE environment variables."
