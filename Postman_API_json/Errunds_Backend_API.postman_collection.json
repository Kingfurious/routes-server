									"value": "YOUR_TASK_ID_HERE",
									"description": "The ID of the task"
								}
							]
						},
						"description": "Get Agora token to join an existing call (for the other party). Updates call status to 'connected' on first join. Requires callId in request body."
					},
					"response": []
				},
				{
					"name": "End Call",
					"request": {
						"method": "POST",
						"header": [
							{
							"key": "Authorization",
							"value": "Bearer {{customer_token}}",
							"type": "text"
							},
							{
								"key": "Content-Type",
