					"name": "Get Privacy by Type",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/v1/terms/privacy",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"terms",
								"privacy"
