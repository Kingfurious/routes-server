						},
						"description": "Get latest active privacy policy. Public endpoint (no authentication required)."
					},
					"response": []
				}
			],
			"description": "Terms & Privacy endpoints (public, no authentication required)"
		}
	],
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:8080",
			"type": "string"
		},
		{
			"key": "firebase_token",
