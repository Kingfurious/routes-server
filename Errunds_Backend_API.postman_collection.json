					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/v1/terms/:type",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"terms",
								":type"
							],
							"variable": [
								{
									"key": "type",
									"value": "terms",
									"description": "Type of document: 'terms' or 'privacy'"
								}
							]
						},
						"description": "Get latest active document by type (terms or privacy). Public endpoint (no authentication required)."
					},
					"response": []
