# ─── Agora (Voice Calls) ────────────────────────────────────────
AGORA_APP_ID=your_agora_app_id
AGORA_APP_CERTIFICATE=your_agora_app_certificate

# ─── Google Routes API ──────────────────────────────────────────
# Server-side key with NO application restriction (or IP-restricted to Cloud Run egress).
# Used by routeController.js to call routes.googleapis.com.
ROUTES_API_KEY=your_google_routes_api_key
